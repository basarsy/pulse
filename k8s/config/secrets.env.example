# Copy to secrets.env (git-ignored) and fill in real values before `kubectl apply -k k8s`.
# Kustomize turns this file into the app-secrets Secret.
POSTGRES_USER=pulse
POSTGRES_PASSWORD=change-me
DB_USERNAME=pulse
DB_PASSWORD=change-me
# HS256 signing key, at least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-value-of-at-least-32-bytes
